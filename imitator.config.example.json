{
  "github": {
    "minimumStars": 200,
    "candidateLimit": 12,
    "inspectLimit": 6
  },
  "acceptance": {
    "minimumOverall": 60,
    "minimumDomainMatch": 50,
    "maximumRisk": 45,
    "allowedLicenses": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"]
