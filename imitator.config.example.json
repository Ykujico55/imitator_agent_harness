{
  "github": {
    "minimumStars": 200,
    "candidateLimit": 12,
    "inspectLimit": 6
  },
  "acceptance": {
    "minimumOverall": 60,
    "minimumDomainMatch": 50,
    "maximumRisk": 45,
    "allowedLicenses": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"]
  },
  "slicing": {
    "maxRepositories": 2,
    "maxFilesPerRepository": 12,
    "maxLinesPerSlice": 60,
    "maxSlices": 48,
    "maxTotalCharacters": 120000
  },
  "review": {
    "minimumConfidence": 0.7,
    "minimumEvidenceSlices": 1,
    "maximumRisk": "medium"
  }
}
