{
  "name": "imitator-agent-harness",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first GitHub precedent discovery for coding agents.",
  "keywords": [
    "pi-package",
    "coding-agent",
    "github",
    "precedent"
  ],
  "pi": {
    "extensions": [
      "./integrations/pi/index.ts"
    ]
  },
  "bin": {
    "imitator": "./src/cli.ts"
  },
  "scripts": {
    "imitator:prepare": "node src/cli.ts prepare",
    "test": "node --test test/*.test.ts",
    "check": "npm test && tsc --noEmit && node src/cli.ts help"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "typebox": "^1.3.25"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^26.4.0",
    "typebox": "^1.3.25",
    "typescript": "^7.0.2"
  }
}
